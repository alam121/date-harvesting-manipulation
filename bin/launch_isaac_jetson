#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
WS="$REPO_ROOT/ur_ws_new"

# ROS setup scripts legitimately probe variables that may be unset, so source
# them with nounset disabled and restore strict checking afterward.
set +u
source /opt/ros/humble/setup.bash
source "$WS/install/setup.bash"
set -u

export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-6}"
export ROS_LOCALHOST_ONLY="${ROS_LOCALHOST_ONLY:-0}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
export ROS_DISCOVERY_SERVER="${ROS_DISCOVERY_SERVER:-10.76.154.75:11811}"
unset FASTRTPS_DEFAULT_PROFILES_FILE

exec ros2 launch ur10e_curobo isaac_jetson_control.launch.py "$@"
