#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
v2_env="${UR10E_CUROBO_V2_ENV:-$HOME/.venvs/datepalm-curobo-v2}"
python3 -m venv --without-pip --system-site-packages "$v2_env"
"$v2_env/bin/python" -m pip install --upgrade pip 'setuptools>=77,<80' packaging wheel
"$v2_env/bin/python" -m pip install -r "$repo_root/requirements-curobo-v2.txt"
"$v2_env/bin/python" -c 'from curobo.motion_planner import MotionPlanner; import torch; print("cuRobo v2 loaded; GPU:", torch.cuda.get_device_name(0))'
