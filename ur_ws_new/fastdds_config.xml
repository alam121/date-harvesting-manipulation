<?xml version="1.0" encoding="UTF-8" ?>
<dds>
    <log>
        <use_default>false</use_default>
        <consumer>
            <class>StdoutErrConsumer</class>
            <property>
                <name>stderr_threshold</name>
                <value>Log::Kind::Error</value>
            </property>
        </consumer>
    </log>
    <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
                <sendBufferSize>8388608</sendBufferSize>
                <receiveBufferSize>8388608</receiveBufferSize>
            </transport_descriptor>
        </transport_descriptors>
        <participant profile_name="participant_profile" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <!-- Setting this replaces the default multicast peer, so keep it
                         for local discovery and add the remote workstation. -->
                    <initialPeersList>
                        <locator><udpv4><address>239.255.0.1</address></udpv4></locator>
                        <locator><udpv4><address>10.76.154.75</address></udpv4></locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
